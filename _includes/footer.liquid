{% capture copyright %}
  &copy; {{ site.time | date: '%Y' }}
  {{ site.first_name }}
  {{ site.middle_name }}
  {{ site.last_name }}
{% endcapture %}

<footer class="{% if site.footer_fixed %}fixed-bottom{% else %}site-footer{% endif %}" role="contentinfo">
  {% if site.newsletter.enabled and site.footer_fixed == false %}
    {% include newsletter.liquid %}
  {% endif %}

  <div class="container">
    <div class="footer-details">
      <span>{{ copyright }}</span>
      {% if site.last_updated %}
        <span
          >Updated <time datetime="{{ site.time | date: '%Y-%m-%d' }}">{{ site.time | date: '%-d %B %Y' }}</time></span
        >
      {% endif %}
    </div>
    <div class="footer-credits">
      {{ site.footer_text }}
      {% if site.impressum_path %}
        <a href="{{ site.impressum_path | relative_url }}">Impressum</a>.
      {% endif %}
    </div>
  </div>
</footer>
